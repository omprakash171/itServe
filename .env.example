# ITServe environment configuration
# Copy to .env (or export these variables) before running with the `mysql` profile.

# --- Database (used by the Spring Boot `mysql` profile) ---
DB_URL=jdbc:mysql://localhost:3306/itserve?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=change-me

# --- Server ---
SERVER_PORT=8081

# --- JWT (REQUIRED in production; use a long random string >= 64 chars) ---
# Generate one with: openssl rand -base64 64
JWT_SECRET=replace-with-a-long-random-secret-at-least-64-characters
JWT_EXPIRATION_MINUTES=480

# --- CORS (comma-separated list of allowed origin patterns) ---
CORS_ORIGINS=http://localhost:[*]

# --- Demo data seeding (true = seed demo users/tickets on first start) ---
SEED_DEMO_DATA=true
